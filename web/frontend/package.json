{
  "name": "cka-labs-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-api.mjs && vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "node scripts/gen-api.mjs && vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:api:bun": "bun scripts/gen-api.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@tanstack/vue-table": "^9.2.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "marked-highlight": "^2.2.4",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
