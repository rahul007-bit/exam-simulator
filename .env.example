# ==============================================================================
# CKA-LABS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this template to .env and adjust variables for your specific environment.
# Zero hardcoded values: all platform scripts, tools, and question modules read from here.

# ------------------------------------------------------------------------------
# 1. Platform Host & User Identities
# ------------------------------------------------------------------------------
# Candidate Linux username (defaults to 'exam' for unprivileged student sandbox)
EXAM_USER=exam

# Platform administrator / host user account (granted sudo rights on the host)
ADMIN_USER=rahul

# ------------------------------------------------------------------------------
# 2. Remote Kubeadm Multi-Node Cluster (SSH)
# ------------------------------------------------------------------------------
# SSH credentials used by the engine to configure and grade remote Kubeadm nodes
SSH_USER=root
SSH_KEY=~/.ssh/id_rsa

# Node 1: Control-Plane Node (Host IP or resolvable DNS name)
NODE_1=192.168.1.57

# Node 2: Worker Node 1 (Host IP or resolvable DNS name)
NODE_2=192.168.1.56

# Node 3: Worker Node 2 (Optional, for 3-node drills)
NODE_3=

# Kubernetes context name for remote Kubeadm cluster
KUBEADM_CONTEXT=kubeadm-vms

# ------------------------------------------------------------------------------
# 3. Local k3d Containerized Cluster
# ------------------------------------------------------------------------------
# Name and Kubernetes version for the local disposable k3d cluster
K3D_CLUSTER_NAME=cka
K3D_K8S_VERSION=v1.30.2-k3s1
K3D_CONTEXT=k3d-cka

# ------------------------------------------------------------------------------
# 4. Web Simulator & Desktop Services
# ------------------------------------------------------------------------------
WEB_PORT=3000
VNC_PORT=5901
NOVNC_PORT=6080
VNC_DISPLAY=:1
VNC_RESOLUTION=1920x1080
